// Copy this file to Secrets.xcconfig (git-ignored) and paste your key.
// Get a key at https://console.cloud.google.com/google/maps-apis
// Enable: Maps SDK for iOS, Routes API, Places API (New).
GOOGLE_MAPS_API_KEY = paste-your-key-here

// Optional, debug builds only: use a dashboard (cablgram-admin, `npm run dev`) running on your
// Mac instead of the deployed one. xcconfig treats // as a comment, hence the $() in the middle.
// The Simulator reaches your Mac at 127.0.0.1; a real iPhone needs your Mac's Wi-Fi address.
// ADMIN_BASE_URL = http:/$()/127.0.0.1:3000

// Optional, debug builds only: on the Simulator, phone sign-in stops at a "not a robot" page.
// YES skips it; only the test numbers set in the Firebase console (Authentication → Sign-in
// method → Phone) can then sign in.
// AUTH_TEST_NUMBERS_ONLY = YES

// Only when testing against a different Firebase project than the released app: that project's
// "Encoded App ID" (Firebase console → Project settings → the iOS app), so phone sign-in can
// return to the app.
// GOOGLE_REVERSED_CLIENT_ID = app-1-0000000000-ios-0000000000000000000000
