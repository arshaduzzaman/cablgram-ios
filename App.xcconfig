// Shared build settings for the Cablgram target.
//
// The Google Maps API key lives in Secrets.xcconfig, which is git-ignored.
// Copy Secrets.example.xcconfig to Secrets.xcconfig and paste your key there.
// Without a key the app falls back to Apple Maps.
GOOGLE_MAPS_API_KEY =

// Google Sign-In callback scheme: REVERSED_CLIENT_ID from GoogleService-Info.plist.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.not-configured

#include? "Secrets.xcconfig"
