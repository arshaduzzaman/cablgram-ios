// Firestore rules for the Cablgram app (Firebase project cg-app-b10ba).
//
// TEMPORARY, for development: any signed-in user can read and write
// anything. The strict rules are in firestore.final.rules; publish those
// once the features are final, before the app goes out.
//
// Paste this whole file into Firebase console → Firestore Database → Rules
// and press Publish.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
