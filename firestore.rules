// Firestore rules for the Cablgram app (Firebase project cg-app-b10ba).
// Paste the whole file into Firebase console → Firestore Database → Rules
// and press Publish.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leaderboard: one document per signed-in user with their step totals.
    match /walkers/{uid} {
      // Any signed-in user can see the leaderboard.
      allow read: if request.auth != null;

      // You can only write your own entry, with sane numbers.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.totalSteps is int
        && request.resource.data.totalSteps >= 0
        && request.resource.data.totalSteps <= 5000000
        && request.resource.data.weekSteps is int
        && request.resource.data.weekSteps >= 0
        && request.resource.data.weekSteps <= 1000000
        // Steps spent on eggs and headlines: never more than walked, and
        // never going back down.
        && (!('spentSteps' in request.resource.data)
            || (request.resource.data.spentSteps is int
                && request.resource.data.spentSteps >= 0
                && request.resource.data.spentSteps <= request.resource.data.totalSteps
                && (resource == null
                    || !('spentSteps' in resource.data)
                    || request.resource.data.spentSteps >= resource.data.spentSteps)));
    }

    // News feed: shared slaps, voice notes, eggs and headlines on each post.
    match /newsPosts/{postId} {
      allow read: if request.auth != null;

      // The slap counter only ever goes up by one.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['slaps'])
        && request.resource.data.slaps == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['slaps'])
        && request.resource.data.slaps == resource.data.slaps + 1;

      // A handprint where someone slapped the photo.
      match /marks/{markId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'x', 'y', 'a', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.x is number
          && request.resource.data.x >= 0 && request.resource.data.x <= 1
          && request.resource.data.y is number
          && request.resource.data.y >= 0 && request.resource.data.y <= 1
          && request.resource.data.a is number
          && request.resource.data.at == request.time;
      }

      // A voice note (up to 10 seconds of small AAC) pinned to a spot.
      // Only the person who recorded it can delete it.
      match /voices/{voiceId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'author', 'x', 'y', 'secs', 'audio', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 80
          && request.resource.data.x is number
          && request.resource.data.x >= 0 && request.resource.data.x <= 1
          && request.resource.data.y is number
          && request.resource.data.y >= 0 && request.resource.data.y <= 1
          && request.resource.data.secs is number
          && request.resource.data.secs <= 11
          && request.resource.data.audio is bytes
          && request.resource.data.audio.size() <= 160000
          && request.resource.data.at == request.time;
        allow delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }

      // A rotten egg someone threw at the photo (it costs them steps).
      match /eggs/{eggId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'x', 'y', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.x is number
          && request.resource.data.x >= 0 && request.resource.data.x <= 1
          && request.resource.data.y is number
          && request.resource.data.y >= 0 && request.resource.data.y <= 1
          && request.resource.data.at == request.time;
      }

      // A headline someone paid steps for. The most steps goes on top.
      match /headlines/{headlineId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'author', 'text', 'steps', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 3
          && request.resource.data.text.size() <= 80
          && request.resource.data.steps is int
          && request.resource.data.steps >= 500
          && request.resource.data.steps <= 5000000
          && request.resource.data.at == request.time;
      }
    }
  }
}
