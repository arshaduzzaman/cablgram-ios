// Firestore rules for the Cablgram app (Firebase project cg-app-b10ba).
// Paste the whole file into Firebase console → Firestore Database → Rules
// and press Publish.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leaderboard: one document per signed-in user with their step totals.
    match /walkers/{uid} {
      // Any signed-in user can see the leaderboard.
      allow read: if request.auth != null;

      // You can only write your own entry, with sane numbers.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.totalSteps is int
        && request.resource.data.totalSteps >= 0
        && request.resource.data.totalSteps <= 5000000
        && request.resource.data.weekSteps is int
        && request.resource.data.weekSteps >= 0
        && request.resource.data.weekSteps <= 1000000;
    }

    // News pile: shared slaps and drawings on each post.
    match /newsPosts/{postId} {
      allow read: if request.auth != null;

      // The slap counter only ever goes up by one.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['slaps'])
        && request.resource.data.slaps == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['slaps'])
        && request.resource.data.slaps == resource.data.slaps + 1;

      // A handprint where someone slapped the photo.
      match /marks/{markId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'x', 'y', 'a', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.x is number
          && request.resource.data.x >= 0 && request.resource.data.x <= 1
          && request.resource.data.y is number
          && request.resource.data.y >= 0 && request.resource.data.y <= 1
          && request.resource.data.a is number
          && request.resource.data.at == request.time;
      }

      // A drawing left on the photo. Only its artist can delete it.
      match /drawings/{drawingId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'author', 'at', 'strokes'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 80
          && request.resource.data.strokes is list
          && request.resource.data.strokes.size() > 0
          && request.resource.data.strokes.size() <= 300
          && request.resource.data.at == request.time;
        allow delete: if request.auth != null
          && resource.data.uid == request.auth.uid;
      }
    }
  }
}
